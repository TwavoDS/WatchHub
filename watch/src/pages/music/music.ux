  width: 360px;
  height: 80px;
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.artist {
  width: 340px;
  height: 34px;
  font-size: 24px;
  color: #dddddd;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.row {
  position: absolute;
  left: 60px;
  top: 240px;
  width: 360px;
  height: 110px;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}
.btn {
  width: 84px;
  height: 84px;
  border-radius: 42px;
  background-color: rgba(255, 255, 255, 0.15);
  justify-content: center;
  align-items: center;
}
.ico {
  width: 44px;
  height: 44px;
}
.ico-play {
  width: 56px;
  height: 56px;
}
.play {
  width: 110px;
  height: 110px;
  border-radius: 55px;
  background-color: #ffffff;
  justify-content: center;
  align-items: center;
}
.vol {
  position: absolute;
  left: 110px;
  top: 366px;
  width: 260px;
  height: 64px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.vbtn {
  width: 64px;
