<template>
  <div class="root">
    <image if="{{art}}" class="art" src="{{art}}"></image>
    <div class="shade"></div>
    <div class="info">
      <text class="app">{{app}}</text>
      <text class="song">{{title}}</text>
      <text class="artist">{{artist}}</text>
    </div>
    <div class="row">
      <div class="btn" onclick="cmd('prev')"><image class="ico" src="/common/img/prev.png"></image></div>
      <div class="play" onclick="cmd('toggle')">
        <image class="ico-play" src="{{playing ? '/common/img/pause.png' : '/common/img/play.png'}}"></image>
      </div>
      <div class="btn" onclick="cmd('next')"><image class="ico" src="/common/img/next.png"></image></div>
    </div>
    <div class="vol">
      <text class="vbtn" onclick="cmd('voldown')">-</text>
      <text class="vtext">{{vol}}%</text>
      <text class="vbtn" onclick="cmd('volup')">+</text>
    </div>
  </div>
</template>

<script>
import * as link from '../../common/link.js'

let unlisten = null
let poll = null

export default {
  private: {
    app: 'Muziek',
    title: 'Niets aan het spelen',
    artist: 'Start muziek op je telefoon',
    playing: false,
    vol: 0,
    art: '',
    artKey: ''
  },

  onShow() {
    link.bind(this.$app)
    unlisten = link.listen((m) => this.onMessage(m))
    link.setPage('music')
    link.send({ cmd: 'music' })
    // The phone sends changes itself; this only catches a missed one
    poll = setInterval(() => link.send({ cmd: 'music' }), 15000)
  },

  onHide() {
    if (unlisten) { unlisten(); unlisten = null }
    if (poll) { clearInterval(poll); poll = null }
    link.setPage('')
  },

  onMessage(m) {
    if (m.t === 'music') {
      if (m.none) {
        this.app = 'Muziek'; this.title = 'Niets aan het spelen'; this.artist = 'Start muziek op je telefoon'
        this.playing = false; this.art = ''; this.artKey = ''
        return
      }
      this.app = m.app || 'Muziek'
      this.title = m.title || '—'
      this.artist = m.artist || ''
      this.playing = !!m.playing
      this.vol = m.vol || 0
      this.artKey = m.art || ''
      this.showArt()
    } else if (m.t === 'imgReady' || m.t === 'imgRetry') {
      this.showArt()
    }
  },

  showArt() {
    const img = link.imageFor(this.artKey)
    this.art = img ? img.uri : ''
  },

  cmd(a) {
    if (a === 'toggle') this.playing = !this.playing
    link.send({ cmd: 'media', a: a })
  }
}
</script>

