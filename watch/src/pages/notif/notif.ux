<template>
  <div class="root">
    <!-- List -->
    <div if="{{!open}}" class="list-page">
      <text class="title">Meldingen</text>
      <text if="{{items.length === 0}}" class="empty">{{status}}</text>
      <list if="{{items.length > 0}}" class="list">
        <list-item for="{{items}}" type="item" class="row" onclick="openItem($idx)">
          <div class="bar" style="background-color: {{$item.color}};"></div>
          <image if="{{$item.icon}}" class="icon" src="{{$item.icon}}"></image>
          <div class="row-text">
            <text class="row-app" style="color: {{$item.color}};">{{$item.app}} · {{$item.time}}</text>
            <text class="row-title">{{$item.title || $item.text}}</text>
          </div>
        </list-item>
        <list-item type="footer" class="footer">
          <text class="clear" onclick="clearAll">Alles wissen</text>
        </list-item>
      </list>
    </div>

    <!-- One notification: a list, because that is what scrolls reliably on the watch -->
    <list if="{{open}}" class="detail" onclick="keepOpen">
      <list-item type="head" class="li-head">
        <image if="{{cur.icon}}" class="big-icon" src="{{cur.icon}}"></image>
        <text class="d-app" style="color: {{cur.color}};">{{cur.call ? cur.app + ' · oproep' : cur.app}} · {{cur.time}}</text>
      </list-item>
      <!-- Text with emoji: drawn by the phone as a picture -->
      <list-item if="{{cur.bodyImg}}" type="bodyimg" class="li-img" style="height: {{cur.bodyH + 16}}px;">
        <image src="{{cur.bodyImg}}" style="width: {{cur.bodyW}}px; height: {{cur.bodyH}}px;"></image>
      </list-item>
      <list-item if="{{!cur.bodyImg && cur.title}}" type="title" class="li-text" style="height: {{cur.titleH}}px;">
        <text class="{{cur.call ? 'd-caller' : 'd-title'}}" style="height: {{cur.titleH}}px;">{{cur.title}}</text>
      </list-item>
      <list-item if="{{!cur.bodyImg && cur.text}}" type="body" class="li-text" style="height: {{cur.textH}}px;">
        <text class="d-text" style="height: {{cur.textH}}px;">{{cur.text}}</text>
      </list-item>

      <!-- Buttons of the notification (e.g. Opnemen / Weigeren / Markeren als gelezen) -->
      <list-item for="{{cur.actions}}" type="action" class="li-btn">
        <text class="act {{$item.cls}}" onclick="doAction($item.i)">{{$item.title}}</text>
      </list-item>

      <!-- Quick replies -->
      <list-item if="{{cur.replies.length > 0}}" type="section" class="li-section">
        <text class="section">Snel antwoorden</text>
      </list-item>
      <list-item for="{{cur.replies}}" type="reply" class="li-btn">
        <div class="reply" onclick="doReply($item.text)">
          <image if="{{$item.img}}" src="{{$item.img}}" style="width: 280px; height: {{$item.h}}px;"></image>
          <text if="{{!$item.img}}" class="reply-t">{{$item.text}}</text>
        </div>
      </list-item>

      <list-item type="buttons" class="li-buttons">
        <text class="btn btn-back" onclick="closeItem">Terug</text>
        <text if="{{!cur.call}}" class="btn btn-done" style="background-color: {{cur.color}};" onclick="dismissCur">Wegtikken</text>
      </list-item>
      <list-item type="foot" class="li-foot">
        <text if="{{sent}}" class="sent">{{sent}}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import * as link from '../../common/link.js'
import brightness from '@system.brightness'
import router from '@system.router'

let unlisten = null
let closeTimer = null
let imgTimer = null
let dismissing = false
let autoClose = false

function actClass(title) {
  const t = String(title || '').toLowerCase()
  if (/weiger|decline|ophang|hang up|afwijz|reject|beëindig/.test(t)) return 'act-red'
  if (/opnem|answer|beantw|accept/.test(t)) return 'act-green'
  return ''
}

/** Rough height of wrapped text, because text in a list collapses without one. */
function textHeight(str, size, width, bold) {
  const s = String(str || '')
  if (!s) return 0
  const perLine = Math.max(8, Math.floor(width / (size * (bold ? 0.6 : 0.55))))
  let lines = 0
  s.split('\n').forEach((p) => { lines += Math.max(1, Math.ceil(p.length / perLine)) })
  return Math.ceil(lines * size * 1.4) + 12
}

export default {
  private: {
    items: [],
    open: false,
    cur: { actions: [], replies: [] },
    status: 'Geen meldingen',
    sent: ''
  },

  onShow() {
    link.bind(this.$app)
    unlisten = link.listen((m) => this.onMessage(m))
    link.setPage('notif')
    autoClose = link.takeAutoClose()
    this.refresh()
    const id = link.takeOpenId()
    if (id !== null) this.openById(id)
    link.sync()
    // Pictures of emoji text can arrive a little later: look again until they're here
    let tries = 0
    if (imgTimer) clearInterval(imgTimer)
    imgTimer = setInterval(() => {
      tries++
      if (this.open && this.waitingForImages()) this.refresh()
      if (tries > 30) { clearInterval(imgTimer); imgTimer = null }
    }, 2000)
  },

  waitingForImages() {
    const n = link.notifs().find((x) => x.id === this.cur.id)
    if (!n) return false
    if (n.img && !this.cur.bodyImg) return true
    return (n.rimg || []).some((k, i) => k && this.cur.replies[i] && !this.cur.replies[i].img)
  },

  onHide() {
    if (unlisten) { unlisten(); unlisten = null }
    this.stopTimer()
    if (imgTimer) { clearInterval(imgTimer); imgTimer = null }
    link.setPage('')
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
  },

  toView(n) {
    const img = link.imageFor(n.img)
    const rimg = n.rimg || []
    return {
      id: n.id,
      app: n.app,
      title: n.title,
      text: n.text,
      time: n.time,
      color: n.color || '#4FC3F7',
      icon: link.iconFor(n.pkg),
      call: !!n.call,
      dur: typeof n.dur === 'number' ? n.dur : 10,
      actions: (n.actions || []).map((a) => ({ i: a.i, title: a.title, cls: actClass(a.title) })),
      bodyImg: img ? img.uri : '',
      bodyW: img ? img.w : 0,
      bodyH: img ? img.h : 0,
      titleH: n.call ? textHeight(n.title, 36, 340, true) + 8 : textHeight(n.title, 26, 320, true),
      textH: textHeight(n.text, 24, 340, false) + 8,
      replies: (n.replies || []).map((r, i) => {
        const ri = link.imageFor(rimg[i])
        return { text: r, img: ri ? ri.uri : '', h: ri ? ri.h : 0 }
      })
    }
  },

  refresh() {
    this.items = link.notifs().map((n) => this.toView(n))
    if (this.open) {
      // Only a real "gone" from the phone closes it (see onMessage); a list that
      // briefly lacks it (phone app just restarted) must not close the screen
      const still = this.items.find((i) => i.id === this.cur.id)
      if (still) this.cur = still
    }
  },

  onMessage(m) {
    if (m.t === 'notif') {
      link.takeOpenId()
      this.refresh()
      this.openById(m.id)
    } else if (m.t === 'gone' && this.open && m.id === this.cur.id && !dismissing) {
      this.refresh()
      this.closeAfterGone()
    } else if (m.t === 'list' || m.t === 'gone' || m.t === 'iconReady' || m.t === 'imgReady' || m.t === 'imgRetry') {
      this.refresh()
    } else if (m.t === 'linkError' || m.t === 'linkClosed') {
      if (this.items.length === 0) this.status = 'Geen verbinding met telefoon'
    }
  },

  openById(id) {
    const idx = this.items.findIndex((i) => i.id === id)
    if (idx >= 0) this.showItem(idx, true)
  },

  openItem(idx) {
    this.showItem(idx, false)
  },

  showItem(idx, automatic) {
    const it = this.items[idx]
    if (!it) return
    this.cur = it
    this.sent = ''
    this.open = true
    this.stopTimer()
    // Close by itself after the display time chosen for this app (not for calls)
    if (automatic && it.dur > 0 && !it.call) {
      closeTimer = setTimeout(() => this.timeUp(), it.dur * 1000)
    }
    // Keep the screen on while the notification is shown, so it doesn't go dark before its time is up
    try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) {}
  },

  stopTimer() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null }
  },

  screenNormal() {
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
  },

  /** Any tap on the notification keeps it open. */
  keepOpen() {
    this.stopTimer()
  },

  timeUp() {
    closeTimer = null
    // Time is up: the screen may go dark again, but the notification stays open,
    // so it is still there when you raise your wrist. Close it with Terug or Wegtikken.
    this.screenNormal()
  },

  closeAfterGone() {
    // Removed on the phone (e.g. call ended)
    this.stopTimer()
    if (autoClose) this.leaveApp()
    else this.open = false
  },

  leaveApp() {
    try { this.$app.exit() } catch (e) {
      try { router.back() } catch (e2) { this.open = false }
    }
  },

  doAction(i) {
    this.stopTimer()
    link.action(this.cur.id, i)
    this.sent = '✓'
    if (!this.cur.call) setTimeout(() => this.dismissCur(), 600)
  },

  doReply(text) {
    this.stopTimer()
    link.reply(this.cur.id, text)
    this.sent = 'Verstuurd: ' + text
    setTimeout(() => this.dismissCur(), 1200)
  },

  closeItem() {
    this.stopTimer()
    this.screenNormal()
    autoClose = false
    this.open = false
  },

  dismissCur() {
    this.stopTimer()
    this.screenNormal()
    dismissing = true
    link.dismiss(this.cur.id)
    dismissing = false
    this.refresh()
    if (autoClose) this.leaveApp()
    else this.open = false
  },

  clearAll() {
    this.items.forEach((i) => link.dismiss(i.id))
    this.refresh()
  }
}
</script>

<style>
.root {
  width: 480px;
  height: 480px;
  background-color: #000000;
}
.list-page {
  width: 480px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  padding-top: 40px;
}
.title {
  font-size: 34px;
  font-weight: bold;
  color: #66bb6a;
  margin-bottom: 8px;
}
.empty {
  margin-top: 100px;
  font-size: 26px;
  color: #888888;
}
.list {
  width: 400px;
  height: 400px;
}
.row {
  width: 400px;
  height: 96px;
  margin-bottom: 10px;
  border-radius: 24px;
  background-color: #1e1e1e;
  flex-direction: row;
  align-items: center;
}
.bar {
  width: 10px;
  height: 96px;
  border-radius: 5px;
}
.icon {
  width: 56px;
  height: 56px;
  margin-left: 14px;
}
.row-text {
  flex: 1;
  flex-direction: column;
  padding-left: 14px;
  padding-right: 14px;
}
.row-app {
  font-size: 20px;
  lines: 1;
  text-overflow: ellipsis;
}
.row-title {
  font-size: 26px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.footer {
  width: 400px;
  height: 120px;
  justify-content: center;
  align-items: flex-start;
}
.clear {
  font-size: 24px;
  color: #ef5350;
  padding: 14px 28px;
  border-radius: 30px;
  background-color: #1e1e1e;
}
.detail {
  width: 480px;
  height: 480px;
}
.li-head {
  width: 480px;
  flex-direction: column;
  align-items: center;
  padding-top: 40px;
}
.li-text {
  width: 480px;
  justify-content: center;
}
.li-img {
  width: 480px;
  justify-content: center;
  align-items: center;
}
.li-section {
  width: 480px;
  height: 44px;
  justify-content: center;
  align-items: flex-end;
}
.li-btn {
  width: 480px;
  height: 66px;
  justify-content: center;
  align-items: center;
}
.li-buttons {
  width: 480px;
  height: 84px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
}
.li-foot {
  width: 480px;
  height: 110px;
  justify-content: center;
}
.big-icon {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  margin-bottom: 6px;
}
.d-app {
  width: 300px;
  height: 30px;
  flex-shrink: 0;
  font-size: 20px;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.d-title {
  width: 320px;
  flex-shrink: 0;
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}
.d-caller {
  width: 340px;
  flex-shrink: 0;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}
.d-text {
  width: 340px;
  flex-shrink: 0;
  font-size: 24px;
  color: #dddddd;
  text-align: center;
}
.section {
  height: 30px;
  flex-shrink: 0;
  font-size: 18px;
  color: #888888;
  margin-top: 18px;
}
.act {
  width: 300px;
  height: 56px;
  font-size: 24px;
  color: #ffffff;
  text-align: center;
  border-radius: 28px;
  background-color: #333333;
}
.act-green {
  background-color: #2e7d32;
}
.act-red {
  background-color: #c62828;
}
.reply {
  width: 300px;
  height: 56px;
  border-radius: 28px;
  background-color: #263238;
  justify-content: center;
  align-items: center;
}
.reply-t {
  width: 280px;
  height: 56px;
  font-size: 22px;
  color: #ffffff;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.btn {
  height: 56px;
  font-size: 22px;
  color: #ffffff;
  text-align: center;
  padding: 0 22px;
  border-radius: 28px;
  margin: 0 6px;
}
.btn-back {
  width: 120px;
  background-color: #333333;
}
.btn-done {
  width: 160px;
  color: #000000;
}
.sent {
  height: 34px;
  flex-shrink: 0;
  font-size: 20px;
  color: #66bb6a;
  margin-top: 8px;
}
</style>
