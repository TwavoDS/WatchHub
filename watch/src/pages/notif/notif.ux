<template>
  <div class="root">
    <!-- List -->
    <div if="{{!open}}" class="list-page">
      <text class="title">Meldingen</text>
      <text if="{{items.length === 0}}" class="empty">{{status}}</text>
      <list if="{{items.length > 0}}" class="list">
        <list-item for="{{items}}" type="item" class="row" onclick="openItem($idx)">
          <div class="bar" style="background-color: {{$item.color}};"></div>
          <image if="{{$item.icon}}" class="icon" src="{{$item.icon}}"></image>
          <div class="row-text">
            <text class="row-app" style="color: {{$item.color}};">{{$item.app}} · {{$item.time}}</text>
            <text class="row-title">{{$item.title || $item.text}}</text>
          </div>
        </list-item>
        <list-item type="footer" class="footer">
          <text class="clear" onclick="clearAll">Alles wissen</text>
        </list-item>
      </list>
    </div>

    <!-- One notification -->
    <div if="{{open}}" class="detail">
      <scroll class="detail-scroll" scroll-y="true">
        <div class="detail-inner" onclick="keepOpen">
          <image if="{{cur.icon}}" class="big-icon" src="{{cur.icon}}"></image>
          <text class="d-app" style="color: {{cur.color}};">{{cur.call ? 'Oproep' : cur.app}} · {{cur.time}}</text>
          <text class="{{cur.call ? 'd-caller' : 'd-title'}}">{{cur.title}}</text>
          <text if="{{cur.text}}" class="d-text">{{cur.text}}</text>

          <!-- Buttons of the notification (e.g. Opnemen / Weigeren / Markeren als gelezen) -->
          <div for="{{cur.actions}}" class="act-row">
            <text class="act {{$item.cls}}" onclick="doAction($item.i)">{{$item.title}}</text>
          </div>

          <!-- Quick replies -->
          <text if="{{cur.replies.length > 0}}" class="section">Snel antwoorden</text>
          <div for="{{cur.replies}}" class="act-row">
            <text class="reply" onclick="doReply($item)">{{$item}}</text>
          </div>

          <div class="buttons">
            <text class="btn btn-back" onclick="closeItem">Terug</text>
            <text if="{{!cur.call}}" class="btn btn-done" style="background-color: {{cur.color}};" onclick="dismissCur">Wegtikken</text>
          </div>
          <text if="{{sent}}" class="sent">{{sent}}</text>
        </div>
      </scroll>
    </div>
  </div>
</template>

<script>
import * as link from '../../common/link.js'
import brightness from '@system.brightness'
import router from '@system.router'

let unlisten = null
let closeTimer = null
let autoClose = false

function actClass(title) {
  const t = String(title || '').toLowerCase()
  if (/weiger|decline|ophang|hang up|afwijz|reject|beëindig/.test(t)) return 'act-red'
  if (/opnem|answer|beantw|accept/.test(t)) return 'act-green'
  return ''
}

export default {
  private: {
    items: [],
    open: false,
    cur: { actions: [], replies: [] },
    status: 'Geen meldingen',
    sent: ''
  },

  onShow() {
    link.bind(this.$app)
    unlisten = link.listen((m) => this.onMessage(m))
    link.setPage('notif')
    autoClose = link.takeAutoClose()
    this.refresh()
    const id = link.takeOpenId()
    if (id !== null) this.openById(id)
    link.sync()
  },

  onHide() {
    if (unlisten) { unlisten(); unlisten = null }
    this.stopTimer()
    link.setPage('')
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
  },

  toView(n) {
    return {
      id: n.id,
      app: n.app,
      title: n.title,
      text: n.text,
      time: n.time,
      color: n.color || '#4FC3F7',
      icon: link.iconFor(n.pkg),
      call: !!n.call,
      dur: typeof n.dur === 'number' ? n.dur : 10,
      actions: (n.actions || []).map((a) => ({ i: a.i, title: a.title, cls: actClass(a.title) })),
      replies: n.replies || []
    }
  },

  refresh() {
    this.items = link.notifs().map((n) => this.toView(n))
    if (this.open) {
      const still = this.items.find((i) => i.id === this.cur.id)
      if (still) this.cur = still
      else this.closeAfterGone()
    }
  },

  onMessage(m) {
    if (m.t === 'notif') {
      link.takeOpenId()
      this.refresh()
      this.openById(m.id)
    } else if (m.t === 'list' || m.t === 'gone' || m.t === 'iconReady') {
      this.refresh()
    } else if (m.t === 'linkError' || m.t === 'linkClosed') {
      if (this.items.length === 0) this.status = 'Geen verbinding met telefoon'
    }
  },

  openById(id) {
    const idx = this.items.findIndex((i) => i.id === id)
    if (idx >= 0) this.showItem(idx, true)
  },

  openItem(idx) {
    this.showItem(idx, false)
  },

  showItem(idx, automatic) {
    const it = this.items[idx]
    if (!it) return
    this.cur = it
    this.sent = ''
    this.open = true
    this.stopTimer()
    // Close by itself after the display time chosen for this app (not for calls)
    if (automatic && it.dur > 0 && !it.call) {
      closeTimer = setTimeout(() => this.timeUp(), it.dur * 1000)
    }
    try { brightness.setKeepScreenOn({ keepScreenOn: it.call || it.dur === 0 }) } catch (e) {}
  },

  stopTimer() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null }
  },

  /** Any tap on the notification keeps it open. */
  keepOpen() {
    this.stopTimer()
  },

  timeUp() {
    closeTimer = null
    if (autoClose) this.leaveApp()
    else this.open = false
  },

  closeAfterGone() {
    // Removed on the phone (e.g. call ended)
    this.stopTimer()
    if (autoClose) this.leaveApp()
    else this.open = false
  },

  leaveApp() {
    try { this.$app.exit() } catch (e) {
      try { router.back() } catch (e2) { this.open = false }
    }
  },

  doAction(i) {
    this.stopTimer()
    link.action(this.cur.id, i)
    this.sent = '✓'
    if (!this.cur.call) setTimeout(() => this.dismissCur(), 600)
  },

  doReply(text) {
    this.stopTimer()
    link.reply(this.cur.id, text)
    this.sent = 'Verstuurd: ' + text
    setTimeout(() => this.dismissCur(), 1200)
  },

  closeItem() {
    this.stopTimer()
    autoClose = false
    this.open = false
  },

  dismissCur() {
    this.stopTimer()
    link.dismiss(this.cur.id)
    this.refresh()
    if (autoClose) this.leaveApp()
    else this.open = false
  },

  clearAll() {
    this.items.forEach((i) => link.dismiss(i.id))
    this.refresh()
  }
}
</script>

<style>
.root {
  width: 480px;
  height: 480px;
  background-color: #000000;
}
.list-page {
  width: 480px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  padding-top: 40px;
}
.title {
  font-size: 34px;
  font-weight: bold;
  color: #66bb6a;
  margin-bottom: 8px;
}
.empty {
  margin-top: 100px;
  font-size: 26px;
  color: #888888;
}
.list {
  width: 400px;
  height: 400px;
}
.row {
  width: 400px;
  height: 96px;
  margin-bottom: 10px;
  border-radius: 24px;
  background-color: #1e1e1e;
  flex-direction: row;
  align-items: center;
}
.bar {
  width: 10px;
  height: 96px;
  border-radius: 5px;
}
.icon {
  width: 56px;
  height: 56px;
  margin-left: 14px;
}
.row-text {
  flex: 1;
  flex-direction: column;
  padding-left: 14px;
  padding-right: 14px;
}
.row-app {
  font-size: 20px;
  lines: 1;
  text-overflow: ellipsis;
}
.row-title {
  font-size: 26px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.footer {
  width: 400px;
  height: 120px;
  justify-content: center;
  align-items: flex-start;
}
.clear {
  font-size: 24px;
  color: #ef5350;
  padding: 14px 28px;
  border-radius: 30px;
  background-color: #1e1e1e;
}
.detail {
  width: 480px;
  height: 480px;
}
.detail-scroll {
  width: 480px;
  height: 480px;
}
.detail-inner {
  width: 480px;
  flex-direction: column;
  align-items: center;
  padding: 50px 70px 90px 70px;
}
.big-icon {
  width: 72px;
  height: 72px;
  margin-bottom: 8px;
}
.d-app {
  font-size: 22px;
}
.d-title {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-top: 6px;
}
.d-caller {
  font-size: 40px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-top: 10px;
}
.d-text {
  font-size: 26px;
  color: #dddddd;
  text-align: center;
  margin-top: 10px;
}
.section {
  font-size: 20px;
  color: #888888;
  margin-top: 22px;
}
.act-row {
  width: 320px;
  justify-content: center;
  margin-top: 10px;
}
.act {
  width: 300px;
  font-size: 26px;
  color: #ffffff;
  text-align: center;
  padding: 16px 0;
  border-radius: 34px;
  background-color: #333333;
}
.act-green {
  background-color: #2e7d32;
}
.act-red {
  background-color: #c62828;
}
.reply {
  width: 300px;
  font-size: 24px;
  color: #ffffff;
  text-align: center;
  padding: 12px 0;
  border-radius: 30px;
  background-color: #263238;
}
.buttons {
  flex-direction: row;
  margin-top: 24px;
}
.btn {
  font-size: 24px;
  color: #ffffff;
  padding: 14px 24px;
  border-radius: 30px;
  margin: 0 8px;
}
.btn-back {
  background-color: #333333;
}
.btn-done {
  color: #000000;
}
.sent {
  font-size: 22px;
  color: #66bb6a;
  margin-top: 12px;
}
</style>
