<template>
  <!-- A list, so the menu scrolls (finger or crown) now that there are more items -->
  <list class="root">
    <list-item type="head" class="li-head">
      <text class="title">WatchHub</text>
      <text class="status">{{status}}</text>
    </list-item>
    <list-item for="{{menu}}" type="item" class="li-item">
      <div class="item" onclick="go($item.page)">
        <div class="dot" style="background-color: {{$item.color}};"></div>
        <text class="label">{{$item.label}}</text>
        <text if="{{$item.page === 'notif' && count > 0}}" class="badge">{{count}}</text>
      </div>
    </list-item>
    <list-item type="find" class="li-find">
      <text class="find {{ringing ? 'find-on' : ''}}" onclick="toggleFind">{{ringing ? 'Stop zoeken' : 'Zoek telefoon'}}</text>
    </list-item>
    <list-item type="foot" class="li-foot"><text class="status"></text></list-item>
  </list>
</template>

<script>
import router from '@system.router'
import * as link from '../../common/link.js'

let unlisten = null

export default {
  private: {
    menu: [
      { page: 'notif', label: 'Meldingen', color: '#66bb6a' },
      { page: 'nav', label: 'Navigatie', color: '#1976d2' },
      { page: 'music', label: 'Muziek', color: '#ab47bc' },
      { page: 'camera', label: 'Camera', color: '#ff6b00' },
      { page: 'actions', label: 'Acties', color: '#ffca28' }
    ],
    status: 'Verbinden…',
    count: 0,
    ringing: false
  },

  onShow() {
    link.bind(this.$app)
    unlisten = link.listen((m) => this.onMessage(m))
    link.setPage('home')
    link.send({ cmd: 'hello' }, (info) => {
      this.status = 'Geen verbinding met telefoon (' + info.substring(0, 30) + ')'
    })
    link.sync()
    this.count = link.notifs().length
  },

  onHide() {
    if (unlisten) { unlisten(); unlisten = null }
  },

  onMessage(m) {
    if (m.t === 'linkOpen' || m.t === 'list' || m.t === 'notif' || m.t === 'gone' || m.t === 'hello') {
      this.status = 'Verbonden met telefoon'
    }
    this.count = link.notifs().length
  },

  toggleFind() {
    this.ringing = !this.ringing
    link.findPhone(this.ringing)
  },

  go(page) { router.push({ uri: '/pages/' + page }) }
}
</script>

<style>
.root {
  width: 480px;
  height: 480px;
  background-color: #000000;
}
.li-head {
  width: 480px;
  height: 120px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.li-item {
  width: 480px;
  height: 84px;
  justify-content: center;
  align-items: center;
}
.li-find {
  width: 480px;
  height: 80px;
  justify-content: center;
  align-items: center;
}
.li-foot {
  width: 480px;
  height: 100px;
}
.title {
  height: 44px;
  font-size: 34px;
  font-weight: bold;
  color: #4fc3f7;
}
.status {
  height: 30px;
  font-size: 20px;
  color: #888888;
  margin-bottom: 6px;
}
.item {
  width: 320px;
  height: 74px;
  border-radius: 44px;
  background-color: #1e1e1e;
  flex-direction: row;
  align-items: center;
  padding-left: 30px;
}
.dot {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  margin-right: 24px;
}
.dot-cam {
  background-color: #ff6b00;
}
.dot-nav {
  background-color: #1976d2;
}
.dot-notif {
  background-color: #66bb6a;
}
.find {
  width: 230px;
  height: 56px;
  border-radius: 28px;
  background-color: #3a3000;
  color: #ffca28;
  font-size: 22px;
  text-align: center;
}
.find-on {
  background-color: #b71c1c;
  color: #ffffff;
}
.label {
  font-size: 32px;
  color: #ffffff;
}
.badge {
  margin-left: 20px;
  min-width: 44px;
  height: 44px;
  border-radius: 22px;
  background-color: #ef5350;
  color: #ffffff;
  font-size: 24px;
  text-align: center;
  padding: 0 10px;
}
</style>
