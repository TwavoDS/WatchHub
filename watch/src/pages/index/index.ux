<template>
  <div class="root">
    <text class="title">WatchHub</text>
    <text class="status">{{status}}</text>

    <div class="item" onclick="goCamera">
      <div class="dot dot-cam"></div>
      <text class="label">Camera</text>
    </div>
    <div class="item" onclick="goNav">
      <div class="dot dot-nav"></div>
      <text class="label">Navigatie</text>
    </div>
    <div class="item" onclick="goNotif">
      <div class="dot dot-notif"></div>
      <text class="label">Meldingen</text>
      <text if="{{count > 0}}" class="badge">{{count}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import * as link from '../../common/link.js'

let unlisten = null

export default {
  private: {
    status: 'Verbinden…',
    count: 0
  },

  onShow() {
    link.bind(this.$app)
    unlisten = link.listen((m) => this.onMessage(m))
    link.setPage('home')
    link.send({ cmd: 'hello' }, (info) => {
      this.status = 'Geen verbinding met telefoon (' + info.substring(0, 30) + ')'
    })
    link.sync()
    this.count = link.notifs().length
  },

  onHide() {
    if (unlisten) { unlisten(); unlisten = null }
  },

  onMessage(m) {
    if (m.t === 'linkOpen' || m.t === 'list' || m.t === 'notif' || m.t === 'gone' || m.t === 'hello') {
      this.status = 'Verbonden met telefoon'
    }
    this.count = link.notifs().length
  },

  goCamera() { router.push({ uri: '/pages/camera' }) },
  goNav() { router.push({ uri: '/pages/nav' }) },
  goNotif() { router.push({ uri: '/pages/notif' }) }
}
</script>

<style>
.root {
  width: 480px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding-top: 50px;
}
.title {
  font-size: 40px;
  font-weight: bold;
  color: #4fc3f7;
}
.status {
  font-size: 20px;
  color: #888888;
  margin-bottom: 14px;
}
.item {
  width: 320px;
  height: 88px;
  margin-top: 12px;
  border-radius: 44px;
  background-color: #1e1e1e;
  flex-direction: row;
  align-items: center;
  padding-left: 30px;
}
.dot {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  margin-right: 24px;
}
.dot-cam {
  background-color: #ff6b00;
}
.dot-nav {
  background-color: #1976d2;
}
.dot-notif {
  background-color: #66bb6a;
}
.label {
  font-size: 32px;
  color: #ffffff;
}
.badge {
  margin-left: 20px;
  min-width: 44px;
  height: 44px;
  border-radius: 22px;
  background-color: #ef5350;
  color: #ffffff;
  font-size: 24px;
  text-align: center;
  padding: 0 10px;
}
</style>
